{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "baseUrl": "../../../..",
    "paths": {
      "yjs": ["packages/collaboration/node_modules/yjs"],
      "slate": ["packages/editor-collab/node_modules/slate"],
      "react-dnd": ["packages/editor/node_modules/react-dnd"],
      "react-dnd-html5-backend": ["packages/editor/node_modules/react-dnd-html5-backend"],
      "@tau/collaboration": ["packages/collaboration/src/index.ts"],
      "@tau/editor/*": ["packages/editor/*"],
      "@tau/db-schema/*": ["packages/db-schema/*"],
      "@tau/plugins/whiteboard": ["packages/plugins/src/whiteboard.ts"]
    }
  },
  "include": [
    "*.ts",
    "*.tsx",
    "../../../../packages/collaboration/src/node-tree-history.test.ts",
    "../../../../packages/collaboration/src/node-tree-scopes.test.ts",
    "../../../../packages/collaboration/src/node-tree-depth.test.ts",
    "../../../../packages/collaboration/src/whiteboard-contract.test.ts",
    "../../../../packages/editor-collab/src/__tests__/node-tree-host-history.test.tsx",
    "../../../../packages/editor-source-view/src/SourceCodeEditor.tsx"
  ]
}
