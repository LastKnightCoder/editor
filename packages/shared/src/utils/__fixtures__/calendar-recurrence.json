[
  {
    "name": "任意时刻范围按本地日期包含首尾日",
    "timeZone": "Asia/Shanghai",
    "rule": { "type": "daily", "interval": 1, "startDate": "2026-01-05T00:00:00+08:00" },
    "start": "2026-01-05T12:00:00+08:00",
    "end": "2026-01-06T12:00:00+08:00",
    "expected": ["2026-01-05T00:00:00+08:00", "2026-01-06T00:00:00+08:00"]
  },
  {
    "name": "窗口外已耗尽次数不能重新计数",
    "timeZone": "Asia/Shanghai",
    "rule": {
      "type": "daily",
      "interval": 1,
      "startDate": "2026-01-01T00:00:00+08:00",
      "maxOccurrences": 2
    },
    "start": "2026-01-05T00:00:00+08:00",
    "end": "2026-01-06T00:00:00+08:00",
    "expected": []
  },
  {
    "name": "每七周与次数上限",
    "timeZone": "Asia/Shanghai",
    "rule": {
      "type": "weekly",
      "interval": 7,
      "weekdays": [1],
      "startDate": "2026-01-05T00:00:00+08:00",
      "maxOccurrences": 3
    },
    "start": "2026-01-01T00:00:00+08:00",
    "end": "2026-05-01T00:00:00+08:00",
    "expected": [
      "2026-01-05T00:00:00+08:00",
      "2026-02-23T00:00:00+08:00",
      "2026-04-13T00:00:00+08:00"
    ]
  },
  {
    "name": "每十四周",
    "timeZone": "Asia/Shanghai",
    "rule": { "type": "weekly", "interval": 14, "startDate": "2026-01-05T00:00:00+08:00" },
    "start": "2026-01-01T00:00:00+08:00",
    "end": "2026-05-01T00:00:00+08:00",
    "expected": ["2026-01-05T00:00:00+08:00", "2026-04-13T00:00:00+08:00"]
  },
  {
    "name": "月末钳制不漂移",
    "timeZone": "Asia/Shanghai",
    "rule": {
      "type": "monthly",
      "interval": 1,
      "monthDay": 31,
      "startDate": "2026-01-31T00:00:00+08:00"
    },
    "start": "2026-01-01T00:00:00+08:00",
    "end": "2026-04-01T00:00:00+08:00",
    "expected": [
      "2026-01-31T00:00:00+08:00",
      "2026-02-28T00:00:00+08:00",
      "2026-03-31T00:00:00+08:00"
    ]
  },
  {
    "name": "节假日顺延去重并保持原周期",
    "timeZone": "Asia/Shanghai",
    "rule": {
      "type": "daily",
      "interval": 1,
      "excludeHolidays": true,
      "startDate": "2026-09-30T00:00:00+08:00",
      "maxOccurrences": 8
    },
    "start": "2026-09-30T00:00:00+08:00",
    "end": "2026-10-07T00:00:00+08:00",
    "holidays": ["2026-10-01T00:00:00+08:00", "2026-10-02T00:00:00+08:00"],
    "expected": [
      "2026-09-30T00:00:00+08:00",
      "2026-10-05T00:00:00+08:00",
      "2026-10-06T00:00:00+08:00",
      "2026-10-07T00:00:00+08:00"
    ]
  },
  {
    "name": "离线只顺延周末",
    "timeZone": "Asia/Shanghai",
    "rule": {
      "type": "daily",
      "interval": 1,
      "excludeHolidays": true,
      "startDate": "2026-10-02T00:00:00+08:00"
    },
    "start": "2026-10-02T00:00:00+08:00",
    "end": "2026-10-05T00:00:00+08:00",
    "expected": ["2026-10-02T00:00:00+08:00", "2026-10-05T00:00:00+08:00"]
  },
  {
    "name": "冬季日界不使用当前夏令时偏移",
    "timeZone": "America/New_York",
    "rule": { "type": "daily", "interval": 1, "startDate": "2026-01-15T00:00:00-05:00" },
    "start": "2026-01-15T00:00:00-05:00",
    "end": "2026-01-16T00:00:00-05:00",
    "expected": ["2026-01-15T00:00:00-05:00", "2026-01-16T00:00:00-05:00"]
  },
  {
    "name": "春季日界相差二十三小时",
    "timeZone": "America/New_York",
    "rule": { "type": "daily", "interval": 1, "startDate": "2026-03-07T00:00:00-05:00" },
    "start": "2026-03-07T00:00:00-05:00",
    "end": "2026-03-10T00:00:00-04:00",
    "expected": [
      "2026-03-07T00:00:00-05:00",
      "2026-03-08T00:00:00-05:00",
      "2026-03-09T00:00:00-04:00",
      "2026-03-10T00:00:00-04:00"
    ]
  },
  {
    "name": "秋季日界相差二十五小时",
    "timeZone": "America/New_York",
    "rule": { "type": "daily", "interval": 1, "startDate": "2026-10-31T00:00:00-04:00" },
    "start": "2026-10-31T00:00:00-04:00",
    "end": "2026-11-02T00:00:00-05:00",
    "expected": [
      "2026-10-31T00:00:00-04:00",
      "2026-11-01T00:00:00-04:00",
      "2026-11-02T00:00:00-05:00"
    ]
  }
]
