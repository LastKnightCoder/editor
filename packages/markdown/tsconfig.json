{
  // headless：lib 不含 DOM，用了 document / window / HTMLElement 直接编译失败（01 §8.3）
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    // 相对导入写 .ts 扩展名、只用可擦除语法：Electron 主进程与脚本可以包名直接加载源码
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "types": []
  },
  "include": ["src"],
  "exclude": ["src/**/__tests__"]
}
