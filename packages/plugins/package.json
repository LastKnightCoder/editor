{
  "name": "@tau/plugins",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "应用插件契约与受信任开发宿主",
  "exports": {
    ".": "./src/index.ts",
    "./host": "./src/host.ts",
    "./node": "./src/file-storage.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "esbuild src/index.ts src/host.ts src/file-storage.ts --bundle --packages=external --platform=node --format=esm --outdir=dist",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "@types/node": "^20.2.1",
    "@types/react": "19.2.0",
    "typescript": "^5.0.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@tau/editor": "workspace:*",
    "@tau/markdown": "workspace:*"
  }
}
