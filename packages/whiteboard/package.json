{
  "name": "@tau/whiteboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./extensions": "./src/extensions/index.ts",
    "./author": "./src/author.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "test": "vitest run",
    "check": "tsc --noEmit",
    "check:boundaries": "node ../../scripts/check-whiteboard-boundaries.mjs",
    "bench:hit": "cross-env WHITEBOARD_HIT_BENCH=1 vitest run src/utils/benchmarks/hit.benchmark.test.ts --reporter=verbose",
    "bench:render": "cross-env WHITEBOARD_RENDER_BENCH=1 vitest run src/utils/benchmarks/render-profile.benchmark.test.tsx --reporter=verbose"
  },
  "dependencies": {
    "@tau/editor": "workspace:*",
    "@tau/markdown": "workspace:*",
    "@tau/shared": "workspace:*",
    "@tau/themes": "workspace:*",
    "@tau/ui": "workspace:*",
    "@zumer/snapdom": "^2.0.1",
    "ahooks": "^3.7.8",
    "classnames": "^2.3.2",
    "eventemitter3": "^5.0.1",
    "gsap": "^3.12.5",
    "immer": "^10.0.2",
    "is-hotkey": "^0.2.0",
    "lodash": "^4.17.21",
    "lucide-react": "^0.399.0",
    "path-intersection": "^3.1.0",
    "perfect-freehand": "^1.2.3",
    "rbush": "^4.0.1",
    "uuid": "^9.0.1",
    "zustand": "^4.3.8",
    "@tau/db-schema": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "slate": "0.126.2",
    "slate-react": "0.126.4"
  },
  "devDependencies": {
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/node": "^20.2.1",
    "@types/uuid": "^9.0.8",
    "@types/rbush": "^4.0.0",
    "@types/lodash": "^4.14.200",
    "@types/is-hotkey": "^0.1.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "slate": "0.126.2",
    "slate-react": "0.126.4",
    "jsdom": "^24.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "^3.2.4",
    "vitest-canvas-mock": "^0.3.3",
    "cross-env": "^7.0.3"
  }
}
