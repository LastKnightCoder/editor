{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tau-plugin-portal-api",
  "account_id": "ba54fcb8459b528b75991a4de5e5d023",
  "main": "../api/index.ts",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "plugins-api.xiongtao.life", "custom_domain": true }],
  "vars": {
    "WEB_ORIGIN": "https://plugins.xiongtao.life",
    "API_ORIGIN": "https://plugins-api.xiongtao.life",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "plugin-portal",
      "database_id": "dabf8820-d2bc-47ab-984d-dc4f0c2ae0bd",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "PENDING", "bucket_name": "tau-plugin-pending" }],
}
