{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "types": ["vite/client", "loadable__component"],
    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      "@tau/editor": ["../../packages/editor/src"],
      "@tau/editor-collab": ["../../packages/editor-collab/src"],
      "@tau/contracts": ["../../packages/contracts/src"],
      "@tau/platform": ["../../packages/platform/src"],
      "@tau/rpc": ["../../packages/rpc/src"],
      "@tau/db-schema/*": ["../../packages/db-schema/*"],
      "@tau/shared": ["../../packages/shared/src"],
      "@tau/shared/*": ["../../packages/shared/*"]
    }
  },
  "include": [
    "src",
    "src-electron",
    "../../packages/shared/src/components/Katex",
    "../../packages/shared/src/components/PlantUML"
  ],
  "exclude": ["demos", "node_modules"]
}
