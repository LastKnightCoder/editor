    "test:collaboration:e2e": "playwright test e2e/collaboration.spec.ts",
    "predev": "pnpm -w db:schema:prepare",
    "dev": "vite --configLoader runner",
    "showcase": "vite --configLoader runner --config vite.config.showcase.mts",
    "prebuild": "pnpm -w db:schema:prepare && pnpm --filter @tau/cli build",
    "build": "cross-env-shell NODE_OPTIONS='--max-old-space-size=8092' \"tsc && vite build --configLoader runner && node scripts/run-electron-builder.mjs && node scripts/verify-native-runtime.mjs\"",
    "verify:native-runtime": "node scripts/verify-native-runtime.mjs",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "bench:whiteboard-hit": "cross-env WHITEBOARD_HIT_BENCH=1 vitest run src/components/WhiteBoard/utils/benchmarks/hit.benchmark.test.ts --reporter=verbose",
    "bench:whiteboard-render-profile": "cross-env WHITEBOARD_RENDER_BENCH=1 vitest run src/components/WhiteBoard/utils/benchmarks/render-profile.benchmark.test.tsx --reporter=verbose"
