COLLAB_PUBLIC_URL=https://collab.taunote.app
# 直连或本机反代部署保持默认 127.0.0.1；Docker + 宿主 nginx 部署在 compose 中已设为 true
COLLAB_TRUST_PROXY=127.0.0.1
COLLAB_MAX_DOCUMENTS=5
COLLAB_MAX_MEMBERS=10
COLLAB_MAX_CONNECTIONS=100
COLLAB_MAX_ACTIVE_DOCUMENTS=20
COLLAB_MAX_DOCUMENT_BYTES=8388608
COLLAB_MAX_ASSET_BYTES=26214400
COLLAB_MAX_DOCUMENT_ASSET_BYTES=209715200
COLLAB_MAX_STORAGE_BYTES=5368709120
