{
  "name": "@tau/website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm check && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.functions.json",
    "test": "vitest run && node --test ../../scripts/website-live-release.test.mjs",
    "deploy:pages": "pnpm build && wrangler pages deploy dist --project-name tau-website --branch master --force"
  },
  "dependencies": {
    "@tau/editor": "workspace:*",
    "@tau/markdown": "workspace:*",
    "@tau/shared": "workspace:*",
    "@tau/themes": "workspace:*",
    "@tau/ui": "workspace:*",
    "ahooks": "^3.10.0",
    "lucide-react": "^0.468.0",
    "react": "19.2.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "19.2.0",
    "slate": "0.126.2",
    "slate-dom": "0.126.0",
    "slate-history": "0.113.1",
    "slate-react": "0.126.4",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.0.4",
    "vite": "7.2.4",
    "vitest": "^3.2.4",
    "wrangler": "4.151.1",
    "yaml": "^2.7.1"
  }
}
