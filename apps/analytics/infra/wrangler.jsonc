{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tau-analytics",
  "main": "../api/index.ts",
  "compatibility_date": "2026-10-18",
  "workers_dev": false,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/v1/*", "/health"],
  },
  "triggers": { "crons": ["17 * * * *"] },
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5181",
    "DOWNLOAD_ORIGIN": "https://dl.taunote.app",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tau-analytics",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "tau-release" }],
  "ratelimits": [
    { "name": "VERSION_LIMITER", "namespace_id": "1101", "simple": { "limit": 120, "period": 60 } },
    { "name": "LOGIN_LIMITER", "namespace_id": "1102", "simple": { "limit": 10, "period": 60 } },
    { "name": "DOWNLOAD_LIMITER", "namespace_id": "1103", "simple": { "limit": 60, "period": 60 } },
  ],
}
