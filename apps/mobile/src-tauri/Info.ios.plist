<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>录制语音并转换为文字，停止后填入输入框。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>使用系统语音识别将你说的话实时转换为文字并填入输入框。</string>
	<!-- 声明可打开 Markdown：微信等应用「用其他应用打开」时列出 Tau；构建时由 Tauri 合并进 gen/apple 的 Info.plist -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Markdown</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>net.daringfireball.markdown</string>
			</array>
		</dict>
	</array>
	<!-- iOS 系统未必内置 Markdown 类型，按扩展名导入声明，否则 .md 只会被识别为未知数据 -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>net.daringfireball.markdown</string>
			<key>UTTypeDescription</key>
			<string>Markdown</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>md</string>
					<string>markdown</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>text/markdown</string>
				</array>
			</dict>
		</dict>
	</array>
	<!-- 导出副本可在系统文件应用访问；导入始终先复制到应用临时目录 -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
