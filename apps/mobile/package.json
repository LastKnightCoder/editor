{
  "name": "mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "pnpm -w db:schema:prepare",
    "dev": "vite",
    "predev:ios": "pnpm -w db:schema:prepare",
    "dev:ios": "tauri ios dev",
    "prebuild": "pnpm -w db:schema:prepare",
    "build": "tsc && vite build",
    "test": "vitest run --config vitest.config.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:android": "tauri android",
    "tauri:ios": "tauri ios",
    "db:schema:prepare": "pnpm -w db:schema:prepare",
    "icon:prepare:android-fg": "bash ./scripts/generate-android-foreground.sh",
    "sync:android:app-name": "node ./scripts/sync-android-app-name.mjs",
    "prepare:android:signing": "bash ./scripts/prepare-android-signing.sh",
    "prebuild:android:test": "pnpm run db:schema:prepare",
    "build:android:test": "pnpm run sync:android:app-name && tauri android build --apk --debug -t aarch64 --split-per-abi --ci",
    "prebuild:android:release": "pnpm run db:schema:prepare",
    "build:android:release": "pnpm run sync:android:app-name && pnpm run prepare:android:signing && tauri android build --apk -t aarch64 --split-per-abi --ci",
    "predev:android": "pnpm run db:schema:prepare",
    "dev:android": "pnpm run sync:android:app-name && tauri android dev",
    "icon:regen": "pnpm run icon:prepare:android-fg && tauri icon src-tauri/icon-manifest.json"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.13.12",
    "@tau/editor": "workspace:*",
    "@tau/shared": "workspace:*",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "ahooks": "^3.9.6",
    "antd": "^6.0.0",
    "lucide-react": "^0.468.0",
    "motion": "12.26.2",
    "react": "19.1.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "19.1.0",
    "slate": "^0.123.0",
    "slate-dom": "^0.123.0",
    "slate-history": "^0.113.1",
    "slate-react": "^0.123.0",
    "words-count": "^2.0.2",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/cli": "^2",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
