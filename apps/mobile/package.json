{
  "name": "mobile",
  "private": true,
  "version": "0.2.3",
  "type": "module",
  "scripts": {
    "dev:plugin-spike": "vite --mode plugin-spike --host 127.0.0.1",
    "build:plugin-spike": "tsc && vite build --mode plugin-spike --outDir dist-plugin-spike",
    "preview:plugin-spike": "vite preview --mode plugin-spike --outDir dist-plugin-spike --host 127.0.0.1 --port 2420 --strictPort",
    "predev": "pnpm -w db:schema:prepare",
    "dev": "vite",
    "predev:ios": "pnpm -w db:schema:prepare && pnpm run sync:ios:icons",
    "dev:ios": "tauri ios dev",
    "prebuild": "pnpm -w db:schema:prepare",
    "build": "tsc && vite build",
    "test": "vitest run --config vitest.config.ts",
    "check:rust": "cargo fmt --check --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -A clippy::all -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:android": "tauri android",
    "tauri:ios": "tauri ios",
    "prebuild:ios:release": "pnpm run check:rust && pnpm run db:schema:prepare && pnpm run sync:ios:icons && cp src-tauri/ios-export.plist src-tauri/gen/apple/ExportOptions.plist",
    "build:ios:release": "tauri ios build --target aarch64 --export-method app-store-connect --ci",
    "db:schema:prepare": "pnpm -w db:schema:prepare",
    "icon:prepare:android-fg": "bash ./scripts/generate-android-foreground.sh",
    "sync:android:app-name": "node ./scripts/sync-android-app-name.mjs",
    "sync:ios:icons": "node ./scripts/sync-ios-icons.mjs",
    "prepare:android:signing": "node ./scripts/prepare-android-signing.mjs",
    "test:android:signing": "node --test ./scripts/prepare-android-signing.test.mjs",
    "prebuild:android:test": "pnpm run db:schema:prepare && pnpm run check:rust",
    "build:android:test": "pnpm run sync:android:app-name && pnpm run prepare:android:signing && tauri android build --apk --debug -t aarch64 --split-per-abi --ci",
    "prebuild:android:release": "pnpm run db:schema:prepare && pnpm run check:rust",
    "build:android:release": "pnpm run sync:android:app-name && pnpm run prepare:android:signing && tauri android build --apk -t aarch64 --split-per-abi --ci",
    "predev:android": "pnpm run db:schema:prepare",
    "dev:android": "pnpm run sync:android:app-name && pnpm run prepare:android:signing && tauri android dev",
    "icon:regen": "pnpm run icon:prepare:android-fg && tauri icon src-tauri/icon-manifest.json",
    "apk": "bash ./scripts/android-release-install.sh"
  },
  "dependencies": {
    "@babel/parser": "7.29.7",
    "parse5": "7.3.0",
    "tailwindcss": "4.1.18",
    "@hocuspocus/provider": "4.6.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-virtual": "3.13.12",
    "@tau/collaboration": "workspace:*",
    "@tau/db-schema": "workspace:*",
    "@tau/editor": "workspace:*",
    "@tau/editor-collab": "workspace:*",
    "@tau/editor-source-view": "workspace:*",
    "@tau/markdown": "workspace:*",
    "@tau/plugins": "workspace:*",
    "@tau/shared": "workspace:*",
    "@tau/themes": "workspace:*",
    "@tau/ui": "workspace:*",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "ahooks": "^3.9.6",
    "lucide-react": "^0.468.0",
    "misans": "^4.1.0",
    "motion": "12.26.2",
    "react": "19.2.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "19.2.0",
    "shiki": "^3.22.0",
    "shiki-magic-move": "^1.2.1",
    "slate": "0.126.2",
    "slate-dom": "0.126.0",
    "slate-history": "0.113.1",
    "slate-react": "0.126.4",
    "y-protocols": "1.0.7",
    "yjs": "13.6.32",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/cli": "^2",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "^4.6.0",
    "esbuild": "^0.25.12",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
