{
  "name": "tau",
  "private": true,
  "version": "0.59.2",
  "scripts": {
    "check:whiteboard-boundaries": "node scripts/check-whiteboard-boundaries.mjs",
    "check:plugin-process-boundaries": "node scripts/check-plugin-process-boundaries.mjs",
    "check:database-boundaries": "node scripts/check-database-boundaries.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "start:win": "chcp 65001 && pnpm --filter desktop dev",
    "dev": "pnpm --filter desktop dev",
    "showcase": "pnpm --filter desktop showcase",
    "dev:collaboration": "node scripts/dev-collaboration.mjs",
    "deploy:collaboration": "node apps/collaboration-cloudflare/scripts/production.mjs deploy --execute",
    "cleanup:collaboration": "bash apps/collaboration-server/scripts/cleanup.sh",
    "build": "cross-env NODE_OPTIONS='--max-old-space-size=8092' pnpm --filter desktop build",
    "dev:website": "pnpm --filter @tau/website dev",
    "dev:analytics": "pnpm --filter @tau/analytics dev",
    "dev:analytics:web": "pnpm --filter @tau/analytics dev:web",
    "build:analytics": "pnpm --filter @tau/analytics build",
    "check:analytics": "pnpm --filter @tau/analytics check",
    "test:analytics": "pnpm --filter @tau/analytics test",
    "build:website": "pnpm --filter @tau/website build",
    "deploy:website": "pnpm --filter @tau/website deploy:pages",
    "publish:desktop": "node scripts/publish-desktop.mjs",
    "publish:mobile": "node scripts/publish-mobile.mjs",
    "publish:fonts": "node scripts/publish-fonts.mjs",
    "migrate:oss-to-r2": "node scripts/migrate-oss-to-r2.mjs",
    "dev:ext": "pnpm --filter browser-extension dev",
    "build:ext": "pnpm --filter browser-extension build",
    "db:schema:build": "node scripts/db/build-schema-bundles.mjs",
    "db:schema:check": "node scripts/db/check-schema-parity.mjs",
    "db:schema:prepare": "pnpm db:schema:build && pnpm db:schema:check && node --experimental-sqlite scripts/db/validate-schema-sql.mjs",
    "check": "pnpm --filter desktop exec tsc --noEmit",
    "lint": "node scripts/quality.mjs lint",
    "lint:all": "node scripts/quality.mjs lint:all",
    "format": "node scripts/quality.mjs format",
    "format:check": "node scripts/quality.mjs format:check",
    "test": "pnpm -r test",
    "prepare": "husky",
    "postinstall": "node scripts/postinstall.mjs",
    "test:collaboration:desktop": "pnpm --filter desktop exec vitest run src-electron/main/modules/collaboration/__tests__",
    "test:quality": "node --test scripts/__tests__/quality-tools.test.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@zumer/snapdom": "^2.0.1",
    "adm-zip": "^0.5.16",
    "ali-oss": "^6.22.0",
    "cross-env": "^7.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-plugin-eslint": "1.89.0",
    "vitest": "^3.2.4"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "subject-case": [
        0
      ],
      "header-max-length": [
        0
      ],
      "body-max-line-length": [
        0
      ],
      "footer-max-line-length": [
        0
      ]
    }
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
