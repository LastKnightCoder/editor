{
  "name": "tau-monorepo",
  "private": true,
  "version": "0.22.0",
  "scripts": {
    "start:win": "chcp 65001 && pnpm --filter desktop dev",
    "dev": "pnpm --filter desktop dev",
    "dev:blog": "pnpm --filter tau-blog-template dev",
    "build": "pnpm --filter desktop build",
    "build:blog": "pnpm --filter tau-blog-template build",
    "check": "pnpm --filter desktop exec tsc --noEmit",
    "check:blog": "pnpm --filter tau-blog-template exec tsc --noEmit",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
