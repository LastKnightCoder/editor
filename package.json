{
  "name": "tau",
  "private": true,
  "version": "0.31.2",
  "scripts": {
    "start:win": "chcp 65001 && pnpm --filter desktop dev",
    "dev": "pnpm --filter desktop dev",
    "dev:blog": "pnpm --filter blog dev",
    "build": "cross-env NODE_OPTIONS='--max-old-space-size=8092' pnpm --filter desktop build",
    "build:blog": "pnpm --filter blog build",
    "check": "pnpm --filter desktop exec tsc --noEmit",
    "check:blog": "pnpm --filter blog exec tsc --noEmit",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "prepare": "husky",
    "postinstall": "pnpm --filter desktop rebuild"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@zumer/snapdom": "^2.0.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.3.5",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "vitest": "^3.2.4"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
