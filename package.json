{
  "name": "tau",
  "private": true,
  "version": "0.47.0",
  "scripts": {
    "start:win": "chcp 65001 && pnpm --filter desktop dev",
    "dev": "pnpm --filter desktop dev",
    "dev:blog": "pnpm --filter blog dev",
    "build": "cross-env NODE_OPTIONS='--max-old-space-size=8092' pnpm --filter desktop build",
    "build:python": "pnpm --filter desktop exec node scripts/build-python.js build",
    "build:blog": "pnpm --filter blog build",
    "dev:ext": "pnpm --filter browser-extension dev",
    "build:ext": "pnpm --filter browser-extension build",
    "db:schema:build": "node scripts/db/build-schema-bundles.mjs",
    "db:schema:check": "node scripts/db/check-schema-parity.mjs",
    "db:schema:prepare": "pnpm db:schema:build && pnpm db:schema:check && node --experimental-sqlite scripts/db/validate-schema-sql.mjs",
    "check": "pnpm --filter desktop exec tsc --noEmit",
    "check:blog": "pnpm --filter blog exec tsc --noEmit",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "prepare": "husky",
    "postinstall": "pnpm --filter desktop run rebuild"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@zumer/snapdom": "^2.0.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.3.5",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "@types/react": "19.1.8",
      "@types/react-dom": "19.1.6",
      "slate": "0.123.0",
      "slate-dom": "0.123.0",
      "slate-react": "0.123.0",
      "slate-history": "0.113.1"
    },
    "patchedDependencies": {
      "better-sqlite3@12.10.0": "patches/better-sqlite3@12.10.0.patch"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
